# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data files (keep folder structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (regenerated by the pipeline; model_card.json is committed)
models_artifacts/*
!models_artifacts/.gitkeep
!models_artifacts/model_card.json

# MLflow experiment tracking (local file store)
mlruns/
mlartifacts/
.mlflow/

# DVC
.dvc/
*.dvc.lock
.dvcignore

# uv
uv.lock.orig

# Env files
.env
.env.local

# Environments & Virtual Envs
.venv/
env/
venv/
ENV/
*.env
.env.*

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# Logs
logs/*
!logs/.gitkeep
*.log

# OS generated files
.DS_Store
Thumbs.db

# Node / React prototype build output
frontend-crm/node_modules/
frontend-crm/dist/
frontend-crm/.vite/

# Ruff / mypy caches
.ruff_cache/
.mypy_cache/

# Local SQLite fallback DB
vantara.db

